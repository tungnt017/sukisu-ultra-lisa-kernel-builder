--- a/fs/devpts/inode.c
+++ b/fs/devpts/inode.c
@@ Description: Hook devpts_get_priv() — Fix PM commands

 Insert BEFORE "if (dentry->d_sb->s_magic" — after function opening.

+#ifdef CONFIG_KSU
+extern int ksu_handle_devpts(struct inode*);
+#endif
 void *devpts_get_priv(struct dentry *dentry)
 {
+#ifdef CONFIG_KSU
+	ksu_handle_devpts(dentry->d_inode);
+#endif
 	if (dentry->d_sb->s_magic != DEVPTS_SUPER_MAGIC)
 		return NULL;
 	return dentry->d_fsdata;
